-- The password of classbeat_maint (ADR 0011 section 5), from the database_maint_password secret
-- file, never an argument or the environment. psql only (a backtick); run right after
-- 30-maint.sql, in the same transaction, by docker/postgres/queue/db-functions.sh.
--
--   $DATABASE_MAINT_PASSWORD_FILE  (default /run/secrets/database_maint_password)

\set ON_ERROR_STOP on
-- As 10-roles.sql and config.py: strip exactly one trailing LF (psql's backtick) and one CR.
\set maint_raw `cat "${DATABASE_MAINT_PASSWORD_FILE:-/run/secrets/database_maint_password}"`
SELECT CASE WHEN right(:'maint_raw', 1) = E'\r' THEN left(:'maint_raw', -1) ELSE :'maint_raw' END
         AS maint_password \gset
\unset maint_raw
SELECT (:'maint_password' = '') AS empty_password \gset
\if :empty_password
  DO $$ BEGIN RAISE EXCEPTION 'the database_maint_password secret file is missing or empty'; END $$;
\endif
ALTER ROLE classbeat_maint PASSWORD :'maint_password';
\unset maint_password
