# /opt/classbeat/.env for an image-only install (ADR 0020; runbook docs/runbooks/vps-deploy.md
# section 5). Placeholders only: copy to .env and fill in. This file holds no secret and neither
# may .env: passwords, keys and client secrets are files under secrets/.
#
# Which compose files make up the stack (every plain `docker compose` command uses them):
COMPOSE_FILE=compose.prod.yaml
# a proxy on this host:       COMPOSE_FILE=compose.prod.yaml:compose.prod.loopback.yaml
# swag on another machine:   COMPOSE_FILE=compose.prod.yaml:compose.prod.lan.yaml, WEB_LAN_ADDRESS=192.168.1.20 below, PROXY_IP = swag's LAN address
# Proton Mail Bridge as well: add :compose.bridge.yaml last (proton-bridge-smtp.md)
COMPOSE_PROJECT_NAME=classbeat-prod
# The release you run: the compose files and both images come from this one release.
CLASSBEAT_VERSION=X.Y.Z
# The public host name, no scheme (web gets CLASSBEAT_PUBLIC_BASE_URL=https://<this>).
CLASSBEAT_DOMAIN=classbeat.example.org
# swag's fixed address: on the shared Docker network (section 6a) or, with the loopback overlay,
# any private address such as 172.29.80.1 (section 6b). One private IPv4 address, never a range.
PROXY_IP=172.29.90.10
SMTP_HOST=smtp.example.org
SMTP_SENDER=noreply@classbeat.example.org
# Support address shown in mail (mailto: and Reply-To); default support@classbeat.eu, the mailbox must exist.
# MAIL_SUPPORT_ADDRESS=support@classbeat.eu

# Optional (defaults in compose.prod.yaml):
# WEB_LAN_ADDRESS=192.168.1.20     (required with compose.prod.lan.yaml: this server's own LAN address)
# WEB_HOST_PORT=8080               (loopback and LAN overlays)
# PROXY_NETWORK=classbeat-proxy
# SMTP_PORT=587
# SMTP_TLS=starttls
# SMTP_USERNAME=
# ADMIN_EMAILS=you@example.org
# SIGNUP_MODE=invite
# CONNECTION_KEK_ID=kek-1
# MODEL_PROVIDER=anthropic
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_VISIBLE_PROVIDERS=google
# Cloudflare Turnstile on the sign-in, sign-up, provider-email and reset forms (runbook section 5b;
# ON by default: web will not start without the site key and a non-empty secrets/turnstile_secret_key,
# unless TURNSTILE_ENABLED=false). The secret key is that file, never here.
# TURNSTILE_SITE_KEY=0x4AAAAAAF3ZKJe4og1j7PsA     (public; the widget must list CLASSBEAT_DOMAIN, new host first on a domain change)
# TURNSTILE_ENABLED=false                          (default true; false is the emergency switch, and what a server needs until the widget and keys exist)
# LOCALES=en,sv,da                 (the languages offered; a subset of what the release ships, en is always on)
# CPU and memory ceilings (runbook section 5c; a CPU value never above the host's core count):
# WORKER_CPUS=1.0
# WORKER_MEMORY=3g                 (CLASSBEAT_MIX_ANALYSIS_CONCURRENCY x 1.5 GiB + about 1 GiB)
# WEB_CPUS=1.0
# WEB_MEMORY=1g
