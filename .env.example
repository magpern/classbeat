# Copy to .env (scripts/worktree.sh init does it). Placeholders only: no secrets here.
# Passwords live in secrets/ (also created by scripts/worktree.sh init), never in this file;
# secrets/database_maint_password is the admin role's (ADR 0011 section 5): db-functions and web.
COMPOSE_PROJECT_NAME=classbeat
WEB_PORT=8000
# The e2e stack's second web on localhost for the passkey specs (compose.e2e.yaml, ADR 0019 section 11).
WEB_PASSKEYS_PORT=8001
DB_PORT=55432
MAILPIT_PORT=8025
# The id of the current connection KEK (secrets/connection_kek), ADR 0004 section 2.
CONNECTION_KEK_ID=kek-1
# The worker's model provider (ADR 0006 section 9): fake (dev and CI) or anthropic, which needs
# a real key in secrets/anthropic_api_key (scripts/worktree.sh init leaves that file empty).
MODEL_PROVIDER=fake
# ADR 0012 section 2: DeepSeek stays off (no host, no route) until the owner decides (section 6).
# Its key (secrets/deepseek_api_key) and OpenAI's (secrets/openai_api_key) are worker-only files
# that scripts/worktree.sh init leaves empty; CLASSBEAT_MODEL_PROVIDER stays fake or anthropic.
DEEPSEEK_ENABLED=false
# ADR 0015: the Swedebeat connection (account page) is off until the owner sets this to true.
# Swedebeat's app key is never here: a release image holds it, or secrets/swedebeat_app (web only).
SWEDEBEAT_ENABLED=false
# ADR 0018: running classes (web and worker); the admin flag running_enabled can only tighten it.
RUNNING_ENABLED=false
# ADR 0007 (soundless classes, web and worker): the kill switch. There is no admin flag; every
# plan's model route must also cover soundless (docs/runbooks/soundless-evals.md).
SOUNDLESS_ENABLED=false
# ADR 0024 (web only): connect MOWL by scanning a QR code; off until the owner's live scan.
MOWL_QR_ENABLED=false
# Optional SMTP certificate pin for a self-signed server such as Proton Mail Bridge (compose.prod.yaml,
# docs/runbooks/proton-bridge-smtp.md). A path inside the web container to a read-only mounted PEM:
# SMTP_CA_FILE=/run/smtp-ca/bridge.pem
# OAuth sign-in (compose.yaml and compose.prod.yaml). Client ids are not secret;
# each client secret is the file secrets/oauth_<provider>_client_secret (web only, empty = off), never a
# variable here. A provider is on only with both. Runbook: docs/runbooks/vps-deploy.md section 5a.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_ID=
# Which enabled providers the sign-in and sign-up screens offer (google, github, microsoft; comma-separated).
OAUTH_VISIBLE_PROVIDERS=google
